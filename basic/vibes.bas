   10 REM Vivid Vibes for Agon Light
   20 REM A mini demoscene production
   30 REM Inspired by oisee/vivid-vibes
   40 :
   50 ON ERROR GOTO 2000
   60 :
   70 REM === INTRO ===
   80 MODE 8: VDU 23,1,0
   90 CLS
  100 VDU 17,128+63: REM White background
  110 FOR I%=0 TO 29
  120   VDU 31,0,I%
  130   PRINT STRING$(40," ");
  140 NEXT
  150 VDU 17,0: REM Black text
  160 VDU 31,12,12: PRINT "VIVID VIBES"
  170 VDU 31,10,14: PRINT "for Agon Light"
  180 VDU 31,8,18: PRINT "Based on ABAP demo"
  190 VDU 31,7,20: PRINT "by OISEE + Claude"
  200 FOR I%=1 TO 200: NEXT
  210 :
  220 REM Fade out
  230 FOR F%=63 TO 0 STEP -4
  240   VDU 19,63,F%*4/63*16+F%*4/63*4+F%*4/63,0,0,0
  250   FOR D%=1 TO 10: NEXT
  260 NEXT
  270 VDU 20: REM Reset palette
  280 :
  290 REM === STARFIELD SECTION ===
  300 GOSUB 3000: REM Init starfield
  310 FOR FR%=1 TO 150
  320   GOSUB 3100: REM Update starfield
  330   IF INKEY(0)<>-1 THEN GOTO 800
  340 NEXT
  350 :
  360 REM === COPPER BARS SECTION ===
  370 MODE 3: VDU 23,1,0
  380 GOSUB 4000: REM Init copper
  390 FOR FR%=1 TO 100
  400   GOSUB 4100: REM Update copper
  410   IF INKEY(0)<>-1 THEN GOTO 800
  420 NEXT
  430 :
  440 REM === PLASMA SECTION ===
  450 MODE 8: VDU 23,1,0
  460 GOSUB 5000: REM Init plasma
  470 FOR FR%=1 TO 100
  480   GOSUB 5100: REM Update plasma
  490   IF INKEY(0)<>-1 THEN GOTO 800
  500 NEXT
  510 :
  520 REM === OUTRO ===
  530 MODE 8: VDU 23,1,0
  540 CLS
  550 VDU 17,63
  560 VDU 31,14,12: PRINT "THE END"
  570 VDU 17,42
  580 VDU 31,8,16: PRINT "Thanks for watching!"
  590 VDU 17,21
  600 VDU 31,10,20: PRINT "Press any key..."
  610 REPEAT UNTIL INKEY(0)<>-1
  620 :
  700 REM === EXIT ===
  800 VDU 23,1,1: MODE 0
  810 PRINT "Vivid Vibes - Agon Light Demo"
  820 PRINT "Inspired by github.com/oisee/vivid-vibes"
  830 END
  840 :
 1000 REM ================================
 1010 REM SUBROUTINES
 1020 REM ================================
 1030 :
 2000 REM Error handler
 2010 VDU 23,1,1: MODE 0
 2020 PRINT "Error: "; ERR; " at line "; ERL
 2030 END
 2040 :
 3000 REM === STARFIELD INIT ===
 3010 CLS
 3020 NS%=60: CX%=160: CY%=120
 3030 DIM SX(NS%), SY(NS%), SZ(NS%)
 3040 FOR I%=1 TO NS%
 3050   SX(I%)=RND(320)-CX%: SY(I%)=RND(240)-CY%: SZ(I%)=RND(256)
 3060 NEXT
 3070 VDU 17,63: VDU 31,14,1: PRINT "HYPERSPACE"
 3080 RETURN
 3090 :
 3100 REM === STARFIELD UPDATE ===
 3110 FOR I%=1 TO NS%
 3120   REM Erase
 3130   IF SZ(I%)<256 THEN SC%=256 DIV (SZ(I%)+1): OX%=CX%+SX(I%)*SC% DIV 32: OY%=CY%+SY(I%)*SC% DIV 32: IF OX%>=0 AND OX%<320 AND OY%>=0 AND OY%<240 THEN GCOL 0,0: PLOT 69,OX%,OY%
 3140   REM Move
 3150   SZ(I%)=SZ(I%)-6: IF SZ(I%)<1 THEN SX(I%)=RND(320)-CX%: SY(I%)=RND(240)-CY%: SZ(I%)=256
 3160   REM Draw
 3170   SC%=256 DIV (SZ(I%)+1): NX%=CX%+SX(I%)*SC% DIV 32: NY%=CY%+SY(I%)*SC% DIV 32
 3180   IF NX%>=0 AND NX%<320 AND NY%>=0 AND NY%<240 THEN BR%=63-SZ(I%) DIV 4: IF BR%>63 THEN BR%=63: IF BR%<0 THEN BR%=0: GCOL 0,BR%: PLOT 69,NX%,NY%
 3190 NEXT
 3200 RETURN
 3210 :
 4000 REM === COPPER INIT ===
 4010 CLS
 4020 NB%=5: BH%=4: CH%=30
 4030 DIM CS%(255)
 4040 FOR I%=0 TO 255: CS%(I%)=INT(127.5+127.5*SIN(I%*PI*2/256)): NEXT
 4050 CT%=0
 4060 RETURN
 4070 :
 4100 REM === COPPER UPDATE ===
 4110 VDU 17,128: CLS
 4120 FOR B%=0 TO NB%-1
 4130   PH%=(B%*256 DIV NB%+CT%*4) AND 255
 4140   YB%=(CH% DIV 2)+(CS%(PH%)-128)*(CH%-BH%) DIV 256
 4150   HU%=(B%*12+CT%) AND 63
 4160   FOR R%=0 TO BH%-1
 4170     Y%=YB%+R%: IF Y%>=0 AND Y%<CH% THEN BR%=BH% DIV 2-ABS(R%-BH% DIV 2): COL%=(HU%+BR%*4) AND 63: VDU 31,0,Y%: VDU 17,128+COL%: PRINT STRING$(80," ");
 4180   NEXT
 4190 NEXT
 4200 CT%=CT%+1
 4210 RETURN
 4220 :
 5000 REM === PLASMA INIT ===
 5010 CLS
 5020 PW%=40: PH%=30: PCX%=20: PCY%=15
 5030 DIM PS%(255), PD%(PW%*PH%-1)
 5040 FOR I%=0 TO 255: PS%(I%)=INT(31.5+31.5*SIN(I%*PI*2/256)): NEXT
 5050 FOR Y%=0 TO PH%-1: FOR X%=0 TO PW%-1: DX%=X%-PCX%: DY%=Y%-PCY%: PD%(Y%*PW%+X%)=INT(SQR(DX%*DX%+DY%*DY%)*6) AND 255: NEXT: NEXT
 5060 PT%=0
 5070 RETURN
 5080 :
 5100 REM === PLASMA UPDATE ===
 5110 P%=0
 5120 FOR Y%=0 TO PH%-1
 5130   VDU 31,0,Y%
 5140   FOR X%=0 TO PW%-1
 5150     V1%=PS%((X%*6+PT%) AND 255): V2%=PS%((Y%*8+PT%*2) AND 255): V3%=PS%(((X%+Y%)*4+PT%) AND 255): V4%=PS%((PD%(P%)+PT%) AND 255)
 5160     COL%=((V1%+V2%+V3%+V4%) DIV 4) AND 63: VDU 17,128+COL%: VDU 32: P%=P%+1
 5170   NEXT
 5180 NEXT
 5190 PT%=PT%+2
 5200 RETURN
